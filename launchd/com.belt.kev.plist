<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.belt.kev</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--python</string>
        <string>3.13</string>
        <string>--extra</string>
        <string>serve</string>
        <string>--directory</string>
        <string>__HOME__/dev/kev</string>
        <string>python</string>
        <string>-m</string>
        <string>kev.serve</string>
        <string>--run</string>
        <string>jaredpalmer/kev-4b</string>
        <string>--port</string>
        <string>8912</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.claude-insights/kev.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude-insights/kev.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>KEV_DTYPE</key>
        <string>bf16</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <!-- Kev-4B typed-question classifier (System One API) on :8912 —
         router-shim ambiguity-band leg. ~8GB RAM resident. -->
</dict>
</plist>
