<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.belt.swarm</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/bun</string>
        <string>__HOME__/.claude/local-llm/swarm.ts</string><string>supervise</string>
    </array>
    <!-- children are services: launchd must not kill the process group when
         the supervisor restarts — the new supervisor adopts live ports -->
    <key>AbandonProcessGroup</key><true/>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.claude-insights/mlx-swarm.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude-insights/mlx-swarm.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BELT_TIER</key>
        <string>__TIER__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:__HOME__/.local/share/uv/tools/mlx-lm/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Swarm: resident specialists (see bin/registry.ts, ~41GB) + router.
         `supervise` is long-running: it respawns a dead :4000 shim, resident
         specialist or :4100 litellm (backoff + circuit breaker,
         bin/supervisor.ts + bin/litellm-target.ts);
         KeepAlive restarts the supervisor itself, which adopts live ports. -->
</dict>
</plist>
